# database configuration
DB_HOST=100.105.195.147
DB_NAME=
DB_USER=
DB_PASSWORD=

# select active regatta if there are several
#ACTIVE_REGATTA_ID=

# time to live of cache entries
CACHE_TTL=60

# host configuration
